NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

NEXT_PUBLIC_STRAVA_CLIENT_ID=
NEXT_PUBLIC_STRAVA_REDIRECT_URI=http://localhost:3000/integrations/strava/callback
STRAVA_CLIENT_SECRET=

# From Supabase dashboard -> Settings -> API. Powers the HealthKit webhook
# route only (app/api/health/webhook) — never used client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Without these, checkout returns "Billing is not configured" —
# the app still builds and every non-billing feature works.
# STRIPE_PRICE_ID is not a secret. The other two are: never commit them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
